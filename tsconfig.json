{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node", "vitest/globals", "vite/client"]
  },
  "include": [".wxt/**/*.d.ts", "extension/entrypoints", "extension/core", "test/modern", "scripts/update-creators.ts", "wxt.config.ts", "vitest.config.ts"],
  "exclude": ["backend", "extension/src", "node_modules", ".output", ".local"]
}
